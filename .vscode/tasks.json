{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: dotnet run (API)",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/DbDataSync.Api"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env":{
          "DbDataSync__Auth__Disabled":"true"
        }
      },
      "dependsOn": "Build solution",
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(x)(y)$",
          "file": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Now listening on:"
        }
      },
      "presentation": {
        "group": "dev-servers",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Frontend: npm run dev (SPA)",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/DbDataSync.Web"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^(x)(y)$",
          "file": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "group": "dev-servers",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Run backend + frontend",
      "dependsOn": [
        "Backend: dotnet run (API)",
        "Frontend: npm run dev (SPA)"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Build solution",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "npm install (SPA)",
      "type": "shell",
      "command": "npm",
      "args": [
        "install"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/DbDataSync.Web"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
