#!/usr/bin/env sh
# Launcher for tools/DataSync.DevHarness. See `scripts/dev-harness help`.
#
# `dotnet run` handles the incremental build itself, including changes in referenced projects such as
# DataSync.Core — which is why there's no staleness check here. It also forwards SIGINT/SIGTERM to the
# app and propagates its exit code, both of which this tool depends on: `up` tears its child processes
# down on a stop signal, and `verify` reports pass/fail through its exit code.
#
# (`dotnet run` spawns the app as a separate child process. That matters where the *parent* kills it
# programmatically, since killing the wrapper doesn't reliably kill the app — which is why
# AppProcesses starts the API with `dotnet exec` on the built DLL instead. It doesn't matter here: the
# OS delivers the signal, and `dotnet run` passes it on.)
set -e

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

exec dotnet run --project "$script_dir/../tools/DataSync.DevHarness" -- "$@"
