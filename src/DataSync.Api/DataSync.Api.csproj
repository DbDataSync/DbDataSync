<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Fido2.AspNet" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Lifetime and logging for a process the Windows SCM starts. Cross-platform to reference; the
         helper it provides answers false everywhere else, so nothing is conditional here. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <!-- Kerberos/NTLM under Kestrel. Cross-platform to reference; it only authenticates anybody on
         Windows, and the sign-in endpoint says so where it does not. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- So AdminCertificateServiceWindowsTests can drive AdminCertificateService.EvaluateKeyAccess's
         internal, testable overload directly (the account passed in, not resolved via a real installed
         Windows service) — the same precedent DataSync.Certificates.csproj already sets for its own
         internal-but-tested members. -->
    <InternalsVisibleTo Include="DataSync.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataSync.Certificates\DataSync.Certificates.csproj" />
    <ProjectReference Include="..\DataSync.Core\DataSync.Core.csproj" />
    <ProjectReference Include="..\DataSync.Scripting\DataSync.Scripting.csproj" />
    <ProjectReference Include="..\DataSync.Drivers.Abstractions\DataSync.Drivers.Abstractions.csproj" />
    <ProjectReference Include="..\DataSync.Drivers.MsSql\DataSync.Drivers.MsSql.csproj" />
    <ProjectReference Include="..\DataSync.Drivers.Postgres\DataSync.Drivers.Postgres.csproj" />
    <ProjectReference Include="..\DataSync.State\DataSync.State.csproj" />
    <ProjectReference Include="..\DataSync.Verification\DataSync.Verification.csproj" />
  </ItemGroup>

  <!--
    The SPA is built into wwwroot on publish, which is what makes the tool and the container one
    artifact rather than two things somebody has to run. Publish only, and skippable: the inner loop
    and the test suites run Vite separately against the API, and making `dotnet build` shell out to
    npm would put a node install between a developer and a unit test.
  -->
  <PropertyGroup>
    <SkipWebBuild Condition="'$(SkipWebBuild)' == ''">false</SkipWebBuild>
    <WebProjectDir>$(MSBuildProjectDirectory)/../DataSync.Web</WebProjectDir>
  </PropertyGroup>

  <Target Name="BuildSpa" BeforeTargets="PrepareForPublish" Condition="'$(SkipWebBuild)' != 'true'">
    <Message Importance="high" Text="Building the SPA in $(WebProjectDir)" />
    <Exec Command="npm ci" WorkingDirectory="$(WebProjectDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(WebProjectDir)" />
    <ItemGroup>
      <SpaOutput Include="$(WebProjectDir)/dist/**/*" />
      <!-- Published rather than copied into the source tree: a wwwroot full of build output is a
           wwwroot somebody commits by accident. -->
      <ResolvedFileToPublish Include="@(SpaOutput)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
