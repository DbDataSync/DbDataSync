<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Deliberately net10.0, not net10.0-windows. The Linux container image (phase 51) publishes
      DataSync.Cli, which references DataSync.Api, which will reference this project for the
      certificate-expiry hosted service — a net10.0-windows TFM here would make that reference an
      SDK error on a project that has to keep building on Linux. Every genuinely Windows-only member
      is marked [SupportedOSPlatform("windows")] instead (phase 51's ServiceCommand precedent), and
      every caller gates on OperatingSystem.IsWindows() before it is reached — see the phase 82 doc's
      "why net10.0, not net10.0-windows" reasoning, restated here at the point it actually bites.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      Windows-only at run time (throws PlatformNotSupportedException off Windows), but the package
      itself targets net-not-windows and restores/builds fine on any OS — confirmed by this project's
      own build succeeding here. Used only by CertificateTemplateCatalog, which is already gated.
    -->
    <PackageReference Include="System.DirectoryServices" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataSync.Core\DataSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataSync.Certificates.Tests" />
  </ItemGroup>

</Project>
