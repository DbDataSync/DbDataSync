<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The command surface, not the web host: asking this tool for help should print text rather than starting Kestrel. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dbdatasync</ToolCommandName>
    <PackageId>DbDataSync</PackageId>
    <!--
      Every build not explicitly versioned gets a fresh alpha, dated and timed at evaluation — nobody
      has to remember to pass one just to `dotnet pack`/`dotnet tool update` this project, which is the
      whole point of tools/install-local-tool's dev loop. -p:Version=X on the command line still wins
      outright: MSBuild treats a command-line property as global, and a global property cannot be
      overwritten by a plain assignment in the project file, conditioned or not — which is exactly what
      lets .github/workflows/release.yml pass -p:Version=YYYY.MM.DD.HHmm and get a real release version
      with no alpha label and no change needed here.

      The seconds component exists for this project alone, not for release.yml: a release is one build
      for one pushed tag, but a dev-loop rerun can happen several times inside the same minute, and
      `dotnet tool update` needs every one of those to look like a genuinely new version. Unpadded ("s",
      not "ss") on purpose: a prerelease identifier is SemVer2-numeric and MUST NOT carry a leading
      zero, unlike the four-part core above it — "-alpha.05" is a hard NETSDK1018 error where "2026.09"
      is merely normalised away, and this is the one part of the string actually built from a two-digit
      clock field often small enough to have one.
    -->
    <Version>$([System.DateTime]::UtcNow.ToString("yyyy.MM.dd.HHmm'-alpha.'s"))</Version>
    <Description>Cross-database replication — a git-tracked config repo, a scheduler, and a web console.</Description>
    <Authors>Dan Shryock</Authors>
    <PackageTags>database;replication;sync;etl;sql-server;mssql;postgresql;cli;dotnet-tool</PackageTags>

    <!--
      Feeds the "Source repository" link and the README tab on the nuget.org listing — both were
      previously blank because nothing here set them, which is a distinct gap from Description above
      (that one already showed up; a listing can render a summary with no link back to the repo and no
      rendered docs at all). RepositoryUrl/RepositoryType is the pair NuGet actually reads for the
      source link; PackageProjectUrl is the separate "Project site" link nuget.org shows alongside it —
      both point at the same GitHub repo here, so set both rather than lean on one implying the other.
    -->
    <RepositoryUrl>https://github.com/DbDataSync/DbDataSync</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/DbDataSync/DbDataSync</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Packed from the ItemGroup below — the repo root README, not a copy kept here. It's the same
         page GitHub shows on the repo's front page, so there is exactly one end-user-facing README to
         keep in sync, not two that quietly drift; anything specific to building from source lives in
         docs/development.md instead, linked from it rather than folded into the package listing. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Framework-dependent and RID-agnostic. LibGit2Sharp, SQLite and DuckDB.NET all ship their native
      assets under runtimes/(rid)/ and resolve at run time, so one package serves every platform.
      Self-contained is ruled out anyway: ProcessSupervisor spawns `dotnet exec`, which needs the
      muxer on PATH.
    -->
    <RollForward>latestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- The `setup` command's TUI (phase 128) — this project's first real package dependency.
         Managed-only (no runtimes/ native assets), net10.0-targeted like this project itself, so it
         adds nothing to worry about for `dotnet tool install -g` or the container image. Pinned
         exact, not a floating range, matching how this repo pins everywhere else. -->
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
    <!-- Phase 136: WindowsServiceEventLog writes/registers directly against the Windows Event Log —
         cross-platform to reference (its own APIs throw PlatformNotSupportedException off Windows,
         which is why every call site is [SupportedOSPlatform("windows")]), same "safe to reference
         everywhere, only does anything real on Windows" reasoning as
         Microsoft.Extensions.Hosting.WindowsServices in DbDataSync.Api.csproj. Pinned to the same
         "10.0.0" this repo already uses for that package and for Microsoft.Extensions.Hosting.Systemd. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbDataSync.Api\DbDataSync.Api.csproj" />
    <ProjectReference Include="..\DbDataSync.Certificates\DbDataSync.Certificates.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.Descriptor\DbDataSync.Drivers.Descriptor.csproj" />
    <ProjectReference Include="..\DbDataSync.Libraries\DbDataSync.Libraries.csproj" />
    <ProjectReference Include="..\DbDataSync.State\DbDataSync.State.csproj" />
    <!-- Referenced so the worker lands in the same output directory as the host that spawns it,
         which is what ApiOptions' beside-the-assembly resolution then finds. -->
    <ProjectReference Include="..\DbDataSync.TaskRunner\DbDataSync.TaskRunner.csproj" />
    <ProjectReference Include="..\DbDataSync.Updates\DbDataSync.Updates.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbDataSync.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Phase 137: every released nupkg to date has shipped with an empty wwwroot. `dotnet pack`/`dotnet
    publish` of THIS project never runs DbDataSync.Api.csproj's own BuildSpa target — that target only
    fires when Api.csproj is published directly, which nothing in this repo's real release path does
    (confirmed against the SDK's own Microsoft.NET.PackTool.targets, and by real dotnet pack/publish
    runs). This mirrors the Dockerfile's own already-proven pattern instead: build the SPA once,
    upstream (CI's own npm ci/npm run build step, ahead of `dotnet pack`), then copy the already-built
    dist/ into place here — a copy step, not a build step, so an ordinary inner-loop `dotnet
    build`/`dotnet test` with no dist/ present (and no npm available) is unaffected.
  -->
  <PropertyGroup>
    <WebProjectDir>$(MSBuildProjectDirectory)/../DbDataSync.Web</WebProjectDir>
  </PropertyGroup>

  <Target Name="CopyPrebuiltSpa" BeforeTargets="Publish" Condition="Exists('$(WebProjectDir)/dist')">
    <ItemGroup>
      <_SpaDist Include="$(WebProjectDir)/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SpaDist)"
          DestinationFiles="@(_SpaDist->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
