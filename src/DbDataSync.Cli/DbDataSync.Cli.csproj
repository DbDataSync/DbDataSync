<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The command surface, not the web host: asking this tool for help should print text rather than starting Kestrel. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dbdatasync</ToolCommandName>
    <PackageId>DbDataSync</PackageId>
    <!--
      Every build not explicitly versioned gets a fresh alpha, dated and timed at evaluation — nobody
      has to remember to pass one just to `dotnet pack`/`dotnet tool update` this project, which is the
      whole point of tools/install-local-tool's dev loop. -p:Version=X on the command line still wins
      outright: MSBuild treats a command-line property as global, and a global property cannot be
      overwritten by a plain assignment in the project file, conditioned or not — which is exactly what
      lets .github/workflows/release.yml pass -p:Version=YYYY.MM.DD.HHmm and get a real release version
      with no alpha label and no change needed here.

      The seconds component exists for this project alone, not for release.yml: a release is one build
      for one pushed tag, but a dev-loop rerun can happen several times inside the same minute, and
      `dotnet tool update` needs every one of those to look like a genuinely new version. Unpadded ("s",
      not "ss") on purpose: a prerelease identifier is SemVer2-numeric and MUST NOT carry a leading
      zero, unlike the four-part core above it — "-alpha.05" is a hard NETSDK1018 error where "2026.09"
      is merely normalised away, and this is the one part of the string actually built from a two-digit
      clock field often small enough to have one.
    -->
    <Version>$([System.DateTime]::UtcNow.ToString("yyyy.MM.dd.HHmm'-alpha.'s"))</Version>
    <Description>Cross-database replication — a git-tracked config repo, a scheduler, and a web console.</Description>

    <!--
      Framework-dependent and RID-agnostic. LibGit2Sharp, SQLite and DuckDB.NET all ship their native
      assets under runtimes/(rid)/ and resolve at run time, so one package serves every platform.
      Self-contained is ruled out anyway: ProcessSupervisor spawns `dotnet exec`, which needs the
      muxer on PATH.
    -->
    <RollForward>latestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbDataSync.Api\DbDataSync.Api.csproj" />
    <ProjectReference Include="..\DbDataSync.Certificates\DbDataSync.Certificates.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.Descriptor\DbDataSync.Drivers.Descriptor.csproj" />
    <ProjectReference Include="..\DbDataSync.Libraries\DbDataSync.Libraries.csproj" />
    <ProjectReference Include="..\DbDataSync.State\DbDataSync.State.csproj" />
    <!-- Referenced so the worker lands in the same output directory as the host that spawns it,
         which is what ApiOptions' beside-the-assembly resolution then finds. -->
    <ProjectReference Include="..\DbDataSync.TaskRunner\DbDataSync.TaskRunner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbDataSync.Cli.Tests" />
  </ItemGroup>

</Project>
