<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DbDataSync.Core\DbDataSync.Core.csproj" />
    <ProjectReference Include="..\DbDataSync.Drivers.Abstractions\DbDataSync.Drivers.Abstractions.csproj" />
    <!-- For ResultSetSchema only. This driver shares none of Generic's readers or writers — a
         query-first source has no statement for them to build — but "read a result set into a
         ChangeRow" is the same problem every reader in the repo already solved once. -->
    <ProjectReference Include="..\DbDataSync.Drivers.Generic\DbDataSync.Drivers.Generic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The `.Full` package, not the bare `DuckDB.NET.Data`, which ships managed bindings only and
      expects a libduckdb the host already has. DbDataSync is deployed as a self-contained service on
      machines nobody installs database engines onto by hand, and CI is a Linux container with no
      DuckDB at all — so the native library travels with the package or the driver does not work
      anywhere but a developer's laptop. `.Full` carries the runtime-identifier assets for linux-x64,
      win-x64 and osx, and needs no RuntimeIdentifier set here to resolve the right one.
    -->
    <!--
      Phase 109i: ExcludeAssets="runtime", the identical treatment 109h gave Microsoft.Data.SqlClient/
      Npgsql. The reference assembly still compiles every DuckDBConnection/DuckDBConnectionStringBuilder
      call site in DuckDbDriver.cs unchanged; the managed DLL is neither copied here nor into
      DbDataSync.Api/.Cli's own output. At first touch, the assembly loads through LibraryRegistry's
      AssemblyLoadContext.Default.Resolving hook instead, once ServeCommand's unconditional install has
      put it under <repo>/libraries/duckdb/lib/ — see ServeCommand.EnsureDuckDbInstalledAsync.

      Phase 146 added ";native": 109i's own "What's explicitly out of scope" left the runtimes/<rid>/
      native/ assets shipping unconditionally — NuGet treats "native" as a distinct asset bucket from
      "runtime", so excluding one never touched the other, and all five platforms' libduckdb copies
      (~150MB uncompressed) rode along in every install regardless of which one a machine could ever
      use. Nothing new to build: LibraryInstaller.RestorePackagesAsync already resolves against
      RuntimeInformation.RuntimeIdentifier (the "SqlClient's SNI shim, DuckDB's libs" case its own
      comment names), so the same install 109i already made unconditional at every `serve` start already
      picks up the one native binary this machine needs — confirmed for real, not assumed: a fresh
      install followed by an actual DuckDBConnection query through the freshly-loaded assembly. No .cs
      file in this project changed either phase.
    -->
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.5" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
