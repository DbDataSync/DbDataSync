<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DbDataSync.DevHarness</RootNamespace>
    <AssemblyName>DbDataSync.DevHarness</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- For the config DTOs posted to the API. Nothing here talks to ConfigRepository directly: the
         harness drives DbDataSync the way an operator does, through its REST API, so that using it
         exercises the same paths a real user would. -->
    <ProjectReference Include="..\..\src\DbDataSync.Core\DbDataSync.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

</Project>
