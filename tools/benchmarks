#!/usr/bin/env sh
# Launcher for tools/DbDataSync.Benchmarks. See `tools/benchmarks --help`.
#
# Built in Release: measurements taken from a Debug build would be meaningless. Otherwise the same
# shape as tools/dev-harness — build every time and `exec` the assembly, so the harness is one
# process rather than a `dotnet run` wrapper plus a child.
set -e

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(dirname "$script_dir")
project="$repo_root/tools/DbDataSync.Benchmarks/DbDataSync.Benchmarks.csproj"

dotnet build "$project" -c Release -v quiet --nologo >&2

exec dotnet exec "$repo_root/tools/DbDataSync.Benchmarks/bin/Release/net10.0/DbDataSync.Benchmarks.dll" "$@"
